Core\Merchant.lua
Core\Bars.lua
Core\Warnings.lua
Core\Weapon.lua
Core\ChatText.lua
Core\Options.lua
Core\Config.lua
Core\Commands.lua

# Tables rather than logic. Loaded before the modules that read them.
Data\Buffs.lua
Data\Consumables.lua
Data\Tracking.lua
Data\Gathering.lua
Data\Reagents.lua
Data\Cooldowns.lua

Modules\Diagnostics.lua
